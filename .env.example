# Copy this file to `.env` and fill in the keys for the providers you use.
# You only need ONE provider to get started.

# ---------------------------------------------------------------------------
# Which model each agent uses, written as  provider:model
# Providers: anthropic | openai | gemini | groq | openrouter | ollama
# ---------------------------------------------------------------------------
JACK_MODEL=anthropic:claude-opus-5-5

# Optional per-agent overrides (fall back to JACK_MODEL when unset).
# Model names change often - check your provider's docs for current ones.
# JACK_MODEL_RESEARCH=anthropic:claude-sonnet-5-5
# JACK_MODEL_STRATEGIST=openai:gpt-5
# JACK_MODEL_STRATEGIST=gemini:gemini-2.5-pro
# JACK_MODEL_RESEARCH=ollama:llama3.1

# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama runs locally and needs no key. Change the URL if it isn't the default.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: better web search for the Research agent (free tier at tavily.com).
# Without it, the agent uses DuckDuckGo, which needs no key.
TAVILY_API_KEY=
